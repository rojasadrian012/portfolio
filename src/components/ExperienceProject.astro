---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getLocalImage } from "@/utils/images";
import type { Project } from "@/types/experience";
import LinkInline from "./LinkInline.astro";

interface Props extends Project {}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { img, description, linkProject } = Astro.props;
const resolvedImg = getLocalImage(img.src);
---

<div>
    {
        description && (
            <p class="text-sm text-gray-700 dark:text-gray-300">
                {description}
            </p>
        )
    }
    {
        resolvedImg && (
            <Image
                alt={img.alt}
                class="rounded-xl object-cover w-full max-w-full h-auto transition duration-500 mb-3"
                loading="lazy"
                width={960}
                src={resolvedImg}
            />
        )
    }

    {
        linkProject && (
            <LinkInline href={linkProject}>
                <small>{t("main.workExperience.viewProjectButton")}</small>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 icon icon-tabler icon-tabler-external-link"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                    <path d="M11 13l9 -9" />
                    <path d="M15 4h5v5" />
                </svg>
            </LinkInline>
        )
    }
</div>
