---
import type { Tag } from "@/types/experience";

interface Props {
    tags: Tag[];
}

const { tags } = Astro.props;
---

<ul class="flex flex-wrap mb-3 gap-2">
    {
        tags.map((tag) => (
            <li>
                <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
                >
                    <tag.icon class="size-4" />
                    {tag.name}
                </span>
            </li>
        ))
    }
</ul>
